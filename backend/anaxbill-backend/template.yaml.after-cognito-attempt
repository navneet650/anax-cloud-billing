AWSTemplateFormatVersion: '2010-09-09'
Transform: AWS::Serverless-2016-10-31
Description: AnaxBill backend API

Globals:
  Function:
    Timeout: 3
    LoggingConfig:
      LogFormat: JSON

Resources:
  AnaxBillApi:
    Type: AWS::Serverless::Api
    Properties:
      StageName: Prod
      Auth:
        DefaultAuthorizer: CognitoAuthorizer
        Authorizers:
          CognitoAuthorizer:
            UserPoolArn: arn:aws:cognito-idp:ap-south-1:990923146026:userpool/ap-south-1_EfkWMBUfv

  AnaxBillApiFunction:
    Type: AWS::Serverless::Function
    Properties:
      CodeUri: hello-world/
      Handler: app.lambdaHandler
      Runtime: nodejs22.x
      Architectures:
        - x86_64
      Events:
        Health:
          Type: Api
          Properties:
            RestApiId: !Ref AnaxBillApi
            Path: /health
            Method: get
            Auth:
              Authorizer: NONE

Outputs:
  AnaxBillApi:
    Description: API Gateway endpoint URL for AnaxBill API
    Value: !Sub "https://${AnaxBillApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}/Prod/health/"
  AnaxBillApiFunction:
    Description: AnaxBill API Lambda Function ARN
    Value: !GetAtt AnaxBillApiFunction.Arn
