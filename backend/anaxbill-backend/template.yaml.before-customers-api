
AWSTemplateFormatVersion: '2010-09-09'
Transform: AWS::Serverless-2016-10-31
Description: AnaxBill backend API

Globals:
  Function:
    Timeout: 3
    LoggingConfig:
      LogFormat: JSON

Resources:
  AnaxBillApiFunction:
    Type: AWS::Serverless::Function
    Properties:
      CodeUri: hello-world/
      Handler: app.lambdaHandler
      Runtime: nodejs22.x
      Architectures:
        - x86_64
      Events:
        Health:
          Type: Api
          Properties:
            Path: /health
            Method: get

  AnaxBillCustomersFunction:
    Type: AWS::Serverless::Function
    Properties:
      CodeUri: customers/
      Handler: app.lambdaHandler
      Runtime: nodejs22.x
      Architectures:
        - x86_64
      Environment:
        Variables:
          CUSTOMERS_TABLE: AnaxBillCustomers
      Policies:
        - DynamoDBCrudPolicy:
            TableName: AnaxBillCustomers

Outputs:
  AnaxBillApi:
    Description: API Gateway endpoint URL for AnaxBill API
    Value: !Sub "https://${ServerlessRestApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}/Prod/health/"
  AnaxBillApiFunction:
    Description: AnaxBill API Lambda Function ARN
    Value: !GetAtt AnaxBillApiFunction.Arn
  AnaxBillCustomersFunction:
    Description: AnaxBill Customers Lambda Function ARN
    Value: !GetAtt AnaxBillCustomersFunction.Arn
